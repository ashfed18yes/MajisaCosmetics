# Supabase Configuration
# Fill in these values in .env.local (do NOT commit .env.local to Git)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudinary Configuration (Server-side image management)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Transactional Email Configuration
# API key obtained from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender email domain or Resend testing email (e.g. Majisa Cosmetics <orders@yourdomain.com> or onboarding@resend.dev)
EMAIL_FROM=
# Notification inbox for business/admin order alerts (e.g. majisacosmeticsales@gmail.com)
ORDER_NOTIFICATION_EMAIL=
# Public application base URL for order links in emails (e.g. https://majisacosmetics.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=


